                      },
                      "insertedContent": {
                        "text": "strcat_s(end, <size of end>,  \".0\")"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "description": {
                "text": "If the combination of strings is larger than the destination buffer, strcat will cbuffer overflow the destination buffer"
